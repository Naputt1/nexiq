{
  "name": "@nexiq/extension-scaffold",
  "version": "0.1.0",
  "private": true,
  "description": "Scaffold template for creating nexiq extensions",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nexiq/extension-sdk": "workspace:*",
    "@nexiq/shared": "workspace:*",
    "better-sqlite3": "^12.8.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@nexiq/extension-sdk": "workspace:*",
    "@nexiq/shared": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "better-sqlite3": "^12.8.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
